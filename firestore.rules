rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user's email is in the students collection
    function isStudent() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/students/$(request.auth.token.email));
    }

    // Helper: check if the authenticated user's email is in the faculty collection
    function isFaculty() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/faculty/$(request.auth.token.email));
    }

    // Helper: check if the authenticated user is an admin
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // Students collection: only admins can write, students/faculty can read their own
    match /students/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // Faculty collection: only admins can write, faculty can read their own
    match /faculty/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin() || isFaculty());
      allow write: if isAdmin();
    }

    // Admins collection: only admins can read/write
    match /admins/{email} {
      allow read, write: if isAdmin();
    }

    // InterviewSlots: students create their own slots; faculty/admin can read pending slots
    match /interviewSlots/{slotId} {
      // Students can read and create their own slots
      allow read: if request.auth != null && (
        isAdmin() ||
        isFaculty() ||
        (isStudent() && resource.data.studentEmail == request.auth.token.email)
      );
      allow create: if isStudent() &&
        request.resource.data.studentEmail == request.auth.token.email &&
        request.resource.data.status == 'pending';
      // Updates happen via Cloud Functions (using admin SDK) for locking/discarding
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // FacultySignups: faculty create signups; all authenticated can read
    match /facultySignups/{signupId} {
      allow read: if request.auth != null;
      allow create: if isFaculty() &&
        request.resource.data.facultyEmail == request.auth.token.email;
      allow update, delete: if isAdmin();
    }
  }
}
